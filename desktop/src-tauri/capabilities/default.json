{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:event:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "cursor://*" }]
    },
    "dialog:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-write-text",
    "deep-link:default",
    "fs:allow-write-file"
  ]
}
